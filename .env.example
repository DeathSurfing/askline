# Askline configuration. Copy this file to .env and edit it.
# The app works with any OpenAI-compatible or Anthropic-compatible endpoint.
# The default below points at the model container the compose file starts.

# --- Bundled model ----------------------------------------------------------
# The compose stack runs llama.cpp server with an OpenAI-compatible API and
# downloads this GGUF from Hugging Face into a volume on first start.
LLM_REPO=LiquidAI/LFM3-1.7B-GGUF
LLM_FILE=LFM3-1.7B-Q8_0.gguf
LLM_PORT=8080
LLM_CTX=8192

# --- Model provider ---------------------------------------------------------
# openai     uses /chat/completions on LLM_BASE_URL (OpenAI, OpenRouter, Groq,
#            Together, vLLM, llama.cpp, LM Studio, and most gateways)
# anthropic  uses /v1/messages on LLM_BASE_URL (Anthropic, or a compatible proxy)
LLM_PROVIDER=openai

# Base URL including the version segment where the provider expects it.
# Bundled:   http://llm:8080/v1
# OpenAI:    https://api.openai.com/v1
# Anthropic: https://api.anthropic.com
# OpenRouter https://openrouter.ai/api/v1
LLM_BASE_URL=http://llm:8080/v1

# Any model id the endpoint accepts. llama.cpp answers to the alias it was
# started with.
LLM_MODEL=lfm3-1.7b

# Sent as a bearer token for openai-compatible endpoints and as x-api-key for
# Anthropic. The bundled llama.cpp server ignores it, but the client requires one.
LLM_API_KEY=local

# 0.0 is deterministic, 0.2 is a good default for factual answers.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# Timezone used for the timestamps the agent shows when recalling memory.
# "local" follows the container or host clock. IANA names also work.
AGENT_TZ=local

# Web search. The compose file runs a SearXNG container and points Askline at it.
# Outside compose, set this to a SearXNG instance you trust, for example
# http://127.0.0.1:8088 when you run searxng/settings.yml with podman yourself.
# Leave it empty to use the built-in Bing -> DuckDuckGo -> Mojeek chain.
# SEARXNG_URL=http://127.0.0.1:8088
SEARXNG_PORT=8088

# Directory for the SQLite database. Inside the container this is a volume.
DATA_DIR=./data

# Web server
PORT=8000
